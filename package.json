{
  "name": "wire",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "build": "bun run --filter './apps/*' --filter './packages/*' --filter './infra' build",
    "dev:api": "bun run --filter @wire/api dev",
    "dev:web": "bun run --filter @wire/web dev",
    "dev:docs": "bun run --filter @wire/docs dev",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' --filter './infra' typecheck",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:oxlint": "oxlint",
    "lint:eslint": "bun run --filter './apps/*' --filter './packages/*' --filter './infra' lint",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "knip": "^5.39.0",
    "oxlint": "^0.15.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}

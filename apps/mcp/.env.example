# Base URL of the Wire API (no /v1 suffix; paths already include it).
WIRE_API_URL=http://localhost:3001

# Auth: either a session cookie value, or email + password (signs in at startup).
# `make seed` creates this local account.
WIRE_EMAIL=dev@wire.local
WIRE_PASSWORD=wire-dev-password
# WIRE_SESSION_TOKEN=
# WIRE_SESSION_COOKIE=better-auth.session_token

# Optional default for tools that take workspaceId.
# WIRE_WORKSPACE_ID=

# stdio (default, for Claude Desktop / Cursor) or http (shared gateway).
# Local `make dev` serves HTTP; Cursor's `.cursor/mcp.json` points at that URL.
# Claude Code / stdio hosts use `apps/mcp/run-stdio.sh` instead.
WIRE_MCP_TRANSPORT=http
WIRE_MCP_BIND=127.0.0.1:3002
# Optional: cap sign-in retries when the API is slow to come up (default 90).
# run-stdio.sh sets this to 5 so IDE hosts fail fast.
# WIRE_MCP_STARTUP_RETRIES=90

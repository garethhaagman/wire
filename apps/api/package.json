{
  "name": "@wire/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo 'no build step — bun runs src/main.ts directly' && exit 0",
    "dev": "bun --watch src/main.ts",
    "generate": "nest generate",
    "lint:wire-rules": "eslint .",
    "openapi:export": "bun scripts/export-openapi.ts && biome format --write ../../internal-docs/api/openapi.yaml",
    "seed": "bun scripts/seed-dev.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@casl/ability": "^7.1.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-ws": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/websockets": "^10.4.15",
    "@wire/config": "workspace:*",
    "@wire/db": "workspace:*",
    "@wire/types": "workspace:*",
    "@wire/ui-config": "workspace:*",
    "ai": "^7.0.181",
    "better-auth": "^1.1.16",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.39.0",
    "rxjs": "^7.8.1",
    "ws": "^8.23.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "@wire/eslint-config": "workspace:*",
    "@wire/eslint-plugin-wire-api": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}

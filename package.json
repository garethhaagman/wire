{
  "name": "wire",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "dev": "turbo run dev --ui=tui --filter=@wire/api --filter=@wire/web --filter=@wire/docs",
    "dev:api": "turbo run dev --ui=tui --filter=@wire/api",
    "dev:web": "turbo run dev --ui=tui --filter=@wire/web",
    "dev:docs": "turbo run dev --ui=tui --filter=@wire/docs",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed": "bun run --cwd apps/api seed",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "bun run lint:oxlint && turbo run lint check:theme",
    "lint:oxlint": "oxlint",
    "test": "turbo run test",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "knip": "^5.39.0",
    "oxlint": "^0.15.1",
    "prettier": "^3.4.2",
    "turbo": "^2.11.13",
    "typescript": "^5.7.2"
  }
}

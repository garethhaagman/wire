{
  "name": "@wire/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/*.tsx",
    "./hooks/*": "./src/*.ts",
    "./lib/*": "./src/*.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build-storybook": "storybook build",
    "check:theme": "bun .storybook/generate-theme-css.ts --check",
    "dev": "storybook dev -p 6006 --no-open",
    "gen:theme": "bun .storybook/generate-theme-css.ts",
    "lint:wire-rules": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@wire/eslint-config": "workspace:*",
    "@wire/eslint-plugin-wire-ui": "workspace:*",
    "@wire/ui-config": "workspace:*",
    "eslint": "^9.17.0",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.9",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}

{
  "name": "wire",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed": "bun run --cwd apps/api seed",
    "db:up": "docker compose up -d --wait postgres redis",
    "dev": "turbo run dev --ui=tui --filter=@wire/api --filter=@wire/web --filter=@wire/docs --filter=@wire/ui",
    "dev:api": "turbo run dev --ui=tui --filter=@wire/api",
    "dev:docs": "turbo run dev --ui=tui --filter=@wire/docs",
    "dev:storybook": "turbo run dev --ui=tui --filter=@wire/ui",
    "dev:web": "turbo run dev --ui=tui --filter=@wire/web",
    "doctor": "npx react-doctor@latest",
    "fix": "ultracite fix",
    "fix:md": "markdownlint-cli2 --fix \"**/*.md\"",
    "knip": "knip",
    "lint": "bun run check && bun run lint:wire-rules && turbo run check:theme && bun run lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:wire-rules": "turbo run lint:wire-rules",
    "prepare": "husky",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "husky": "^9.1.7",
    "knip": "^5.39.0",
    "lint-staged": "^17.6.2",
    "markdownlint-cli2": "^0.24.2",
    "turbo": "^2.11.13",
    "typescript": "^5.7.2",
    "ultracite": "8.3.1"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.1"
  }
}

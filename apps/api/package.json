{
  "name": "@wire/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "echo 'no build step — bun runs src/main.ts directly' && exit 0",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate": "nest generate",
    "openapi:export": "bun scripts/export-openapi.ts"
  },
  "dependencies": {
    "@casl/ability": "^7.1.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/typeorm": "^10.0.2",
    "@wire/config": "workspace:*",
    "@wire/db": "workspace:*",
    "@wire/types": "workspace:*",
    "better-auth": "^1.1.16",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@wire/eslint-config": "workspace:*",
    "@wire/eslint-plugin-wire-api": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}

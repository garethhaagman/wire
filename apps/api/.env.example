NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://wire:wire_dev_password@localhost:5432/wire
# Optional streaming replica for history/search reads.
DATABASE_READ_URL=
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=dev-only-secret-change-me-32chars-min
# App crypto (webhook seal, local-upload HMAC). Required in production; falls
# back to BETTER_AUTH_SECRET in development when unset.
APP_SECRET=dev-only-app-secret-change-me-32chars
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
# Optional: cookie Domain when web + API share a parent (app.example.com +
# api.example.com → example.com). Auto-derived from the two URLs when unset.
AUTH_COOKIE_DOMAIN=

# Optional: "Continue with Google". Create an OAuth client (Web application) at
# https://console.cloud.google.com/apis/credentials with authorized redirect URI
#   http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound email via Resend (https://resend.com). Unset means emails are logged
# to the console instead of delivered. Required in production (email verification).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Wire <no-reply@wire.local>

# Optional: agent runs call Claude via the Vercel AI SDK. Unset means agent runs
# use a deterministic mock model instead (no API key needed).
ANTHROPIC_API_KEY=

# Optional: file uploads go to local disk (./.data/uploads by default) unless
# S3_BUCKET is set, in which case they go to S3Adapter — real AWS, or a local
# Garage instance (`docker compose --profile s3 up -d garage`, then see that
# service's docker-compose.yml comment for one-time setup and to get these
# credentials).
S3_BUCKET=
S3_REGION=garage
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
